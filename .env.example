# Copy to .env and edit. Never commit .env.
# Pass both files:  docker compose --env-file .env --env-file editors/pins.env up -d --build

# Public hostname for automatic HTTPS (e.g. office.example.com). Use :80 for local/testing (plain HTTP).
SITE_ADDRESS=:80
# Host ports published by the proxy (the only ports exposed).
HTTP_PORT=80
HTTPS_PORT=443
# Largest request body the proxy accepts (uploads).
MAX_UPLOAD_BODY=1GB
# Tag recorded on the built image.
APP_VERSION=dev
# Pinned proxy image tag (exact version, never "latest").
CADDY_VERSION=2.11.7-alpine
