# Copy to .env and edit. Never commit .env.
# Pass both files:  docker compose --env-file .env --env-file editors/pins.env up -d --build

# Public hostname for automatic HTTPS (e.g. office.example.com). Use :80 for local/testing (plain HTTP).
SITE_ADDRESS=:80
# Host ports published by the proxy (the only ports exposed).
HTTP_PORT=80
HTTPS_PORT=443
# Largest request body the proxy accepts (uploads).
MAX_UPLOAD_BODY=1GB
# Tag recorded on the built image.
APP_VERSION=dev
# Pinned proxy image tag (exact version, never "latest").
CADDY_VERSION=2.11.7-alpine

# ── Accounts ────────────────────────────────────────────────────────────────
# The first administrator. Set BOTH, start once, then REMOVE the password from this file.
# (Or create one later:  printf '%s' 'a long passphrase' | docker compose exec -T app node dist/cli.js create-admin you@example.com)
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Let anyone who can reach the site create an account. Leave false for a private install.
ALLOW_REGISTRATION=false
# Hours a login stays valid (sliding). 336 = 14 days.
SESSION_TTL_HOURS=336
# Must be true whenever the site is served over HTTPS (any real deployment). Only set false for plain-HTTP testing
# on a non-localhost address, which browsers otherwise reject.
SECURE_COOKIES=true

# ── Storage limits ──────────────────────────────────────────────────────────
# Largest single file (MB). Keep MAX_UPLOAD_BODY (proxy) >= this.
MAX_UPLOAD_MB=500
# Per-user storage quota in MB; 0 = unlimited.
USER_QUOTA_MB=0
# Previous versions kept per file so a bad editor save is recoverable.
KEEP_VERSIONS=5
# Editors autosave often; keep a recoverable checkpoint at most this often (minutes). 0 = every save.
VERSION_INTERVAL_MIN=10

# ── Real-time co-editing ────────────────────────────────────────────────────
# Shared by `app` (signs per-file room tokens) and `collab` (verifies them). Required, >= 32 chars:  openssl rand -hex 32
# Never reuse it elsewhere. Rotating it ends all live editing sessions (clients reconnect with fresh tokens).
COLLAB_JWT_SECRET=
# Hours a room token stays valid. Access changes (unshare/disable) also kick live sessions immediately.
COLLAB_TOKEN_TTL_HOURS=8
# Largest single co-editing message (MB) the collab service accepts.
COLLAB_MAX_PAYLOAD_MB=32
